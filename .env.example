# Copy to .env and fill in: cp .env.example .env
# Sourced by every *_start.sh (through env.sh)

# HF cache root that vLLM reads from; it must hold
#   hub/models--openai--gpt-oss-120b  (weights; hub/models--openai--gpt-oss-20b for MODEL=20b)
#   tiktoken_encodings/               (*.tiktoken vocab files, needed offline)
HF_HOME=/path/to/huggingface

# Which gpt-oss to serve: 120b or 20b
MODEL=120b

# Ports on 127.0.0.1; picked away from common defaults (8000, 4000, 8080) to avoid clashes on a shared server
VLLM_PORT=28000
LITELLM_PORT=24000
# Only used after: bash install.sh full
OPENWEBUI_PORT=28080

# GPU indices for vLLM, e.g. 0 or 2,3; tensor parallel size = number of GPUs (use 1, 2, 4 or 8)
GPUS=0

# Fraction of each GPU's memory vLLM may use; leave it commented out to use the MODEL default in env.sh,
# which was measured on DGX Spark (GB10, memory shared with the OS)
# A single 80 GB GPU needs 0.9 to hold the 60.8 GiB weights of 120b
# GPU_MEMORY_UTILIZATION=0.9

# Generate one with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-change-me

# Open WebUI: allow attaching files in chat (true/false); true needs an embedding model in HF_HOME (see README)
OPENWEBUI_FILE_UPLOAD=false
