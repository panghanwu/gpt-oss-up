# Copy to .env and fill in: cp .env.example .env
# Sourced by vllm_start.sh and litellm_start.sh

# HF cache root that vLLM reads from; it must hold
#   hub/models--openai--gpt-oss-120b  (weights)
#   tiktoken_encodings/               (*.tiktoken vocab files, needed offline)
HF_HOME=/path/to/huggingface

# Ports on 127.0.0.1; picked away from common defaults (8000, 4000) to avoid clashes on a shared server
VLLM_PORT=28000
LITELLM_PORT=24000

# GPU indices for vLLM, e.g. 0 or 2,3; tensor parallel size = number of GPUs (use 1, 2, 4 or 8)
GPUS=0

# Fraction of each GPU's memory vLLM may use (vLLM default: 0.9)
# A single 80 GB GPU needs 0.9 to hold the 60.8 GiB weights; GB10 (memory shared with the OS) used 0.75
GPU_MEMORY_UTILIZATION=0.9

# Generate one with: echo "sk-$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=sk-change-me
